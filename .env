# Database Configuration
DATABASE_NAME=mydatabase
DATABASE_USERNAME=myuser
DATABASE_PASSWORD=mypassword
DATABASE_PORT=5432

# S3 Configuration (MinIO)
S3_BUCKET_NAME=my-bucket
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_PORT=7687

# Parsing Configuration
INPUT_STORAGE=LOCAL
OUTPUT_STORAGE=LOCAL
OCR_ENGINE=TESSERACT

# Input/Output Path Configuration
# For local storage: use relative or absolute local paths
# For S3 storage: use S3 object prefixes (without s3:// prefix)
INPUT_PATH=data/raw
OUTPUT_PATH=data/processed

# Examples for different configurations:
# Local input, Local output:
#   INPUT_STORAGE=LOCAL
#   OUTPUT_STORAGE=LOCAL
#   INPUT_PATH=data/raw
#   OUTPUT_PATH=data/processed
#
# S3 input, S3 output:
#   INPUT_STORAGE=S3
#   OUTPUT_STORAGE=S3
#   INPUT_PATH=documents/raw
#   OUTPUT_PATH=documents/processed
#
# Local input, S3 output:
#   INPUT_STORAGE=LOCAL
#   OUTPUT_STORAGE=S3
#   INPUT_PATH=/local/path/to/pdfs
#   OUTPUT_PATH=processed-docs
#
# S3 input, Local output:
#   INPUT_STORAGE=S3
#   OUTPUT_STORAGE=LOCAL
#   INPUT_PATH=source-documents
#   OUTPUT_PATH=./processed

# Image Processing Configuration
SAVE_IMAGES=true
IMAGE_FORMAT=PNG
IMAGE_QUALITY=95
IMAGE_DPI=300
IMAGE_SCALE=2.0
GENERATE_IMAGE_DESCRIPTIONS=true

# Advanced Processing Configuration
EXTRACT_TABLES=true
EXTRACT_FORMULAS=true
EXTRACT_FIGURES=true
FORCE_FULL_PAGE_OCR=true

# Batch Processing Configuration
PARALLEL_PROCESSING=true
MAX_WORKERS=4
BATCH_SIZE=10
MEMORY_LIMIT_MB=2048

# OCR Optimization Configuration
TESSERACT_LOG_LEVEL=1
OCR_PSM_MODE=6
SKIP_OSD=true
TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
OMP_NUM_THREADS=1